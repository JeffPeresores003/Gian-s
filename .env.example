# Frontend Environment Variables
# VITE_* values are baked into the bundle at BUILD time (npm run build).
# Set the real backend URL BEFORE building for Hostinger, e.g. in a .env.production file:
#   VITE_API_URL=https://gian-backend.onrender.com/api
# Remember to add your Hostinger domain to ALLOWED_ORIGINS on the backend
# (e.g. ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com).
VITE_API_URL=http://localhost:5000/api
